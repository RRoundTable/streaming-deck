{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.rroundtable.sd",
  "Name": "streaming-deck",
  "Author": "RRoundTable",
  "Description": "bin/sd 출력을 키에 표시한다: 딥 블록 남은 시간·휴식·MIT 진행, 다음 미팅·오늘 날짜, VM Claude Code 세션.",
  "Version": "0.1.0.0",
  "SDKVersion": 3,
  "Software": { "MinimumVersion": "7.1" },
  "OS": [{ "Platform": "mac", "MinimumVersion": "13" }],
  "Nodejs": { "Version": "24" },
  "CodePath": "bin/plugin.js",
  "Icon": "imgs/plugin",
  "Category": "streaming-deck",
  "CategoryIcon": "imgs/category",
  "Actions": [
    {
      "UUID": "com.rroundtable.sd.status",
      "Name": "남은 시간",
      "Icon": "imgs/action",
      "Tooltip": "딥 블록 남은 시간과 MIT 진행. 누르면 바로 새로고침",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [{ "Image": "imgs/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.rroundtable.sd.calendar",
      "Name": "캘린더",
      "Icon": "imgs/action",
      "Tooltip": "다음 미팅과 오늘 날짜. 누르면 Google Calendar 오늘 보기",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [{ "Image": "imgs/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.rroundtable.sd.agents",
      "Name": "VM 세션",
      "Icon": "imgs/action",
      "Tooltip": "VM Claude Code 세션: 내 차례(질문·리뷰) 수와 먼저 볼 세션, 실행 중, VM 쉬는 중. 누르면 Desktop 앱의 기다리는 세션",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [{ "Image": "imgs/key", "ShowTitle": false }]
    }
  ]
}
