{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.rroundtable.sd",
  "Name": "streaming-deck",
  "Author": "RRoundTable",
  "Description": "bin/sd 출력을 키에 표시한다: 딥 블록 남은 시간·휴식·MIT 진행, 다음 자리 비움(미팅·식사·퇴근).",
  "Version": "0.1.0.0",
  "SDKVersion": 3,
  "Software": { "MinimumVersion": "7.1" },
  "OS": [{ "Platform": "mac", "MinimumVersion": "13" }],
  "Nodejs": { "Version": "24" },
  "CodePath": "bin/plugin.js",
  "Icon": "imgs/plugin",
  "Category": "streaming-deck",
  "CategoryIcon": "imgs/category",
  "Actions": [
    {
      "UUID": "com.rroundtable.sd.status",
      "Name": "남은 시간",
      "Icon": "imgs/action",
      "Tooltip": "딥 블록 남은 시간과 MIT 진행. 누르면 바로 새로고침",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [{ "Image": "imgs/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.rroundtable.sd.calendar",
      "Name": "자리 비움",
      "Icon": "imgs/action",
      "Tooltip": "가까운 공백과 다음 긴 공백(미팅·식사·퇴근·휴일). 누르면 Google Calendar 오늘 보기",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [{ "Image": "imgs/key", "ShowTitle": false }]
    }
  ]
}
