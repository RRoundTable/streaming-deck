#!/bin/zsh
# Stream Deck 업무 시스템 동작. Hammerspoon(hammerspoon/sd.lua)의 ⌃⌥1/2/3/0이 이 스크립트를 부른다.
#   sd start-day        데일리 노트 생성 → Calendar·Tasks·노트 열기
#   sd deep [완료 조건]   50분 딥 블록 시작 (인자 없으면 입력창)
#   sd deep25 [완료 조건] 25분 딥 블록 시작. 나머지는 deep과 같다
#   sd shutdown         블록 상태 해제 → 데일리 노트 열기
#   sd status [--short] 현재 상태 한 줄 (Hammerspoon 메뉴 막대·HUD가 표시). --short는 " · " 앞만 (Stream Deck 버튼 제목)
#   sd timer            진행 중인 블록의 "끝나는 시각(epoch) 전체 길이(초)" (HUD의 초 단위 타이머용)
#   sd tasks            Deep 선택창 후보 "작업<TAB>설명" (Hammerspoon이 표시)
#   sd agenda           다음 자리 비움 한 줄 "색 가까운 공백 | 긴 공백" (Stream Deck 자리 비움 키가 표시)
#   sd calendar         Google Calendar 오늘 보기 열기 + 캘린더 동기화 후 다시 읽기(백그라운드)
set -euo pipefail

SELF=${0:A}
VAULT=${SD_VAULT:-$HOME/workspace/personal/record-vault}
VAULT_NAME=${VAULT:t}
STATE_DIR=$HOME/.focus
STATE=$STATE_DIR/state.json
TODAY=$(date +%F)
NOTE=$VAULT/Daily/$TODAY.md     # 사람이 편집. sd는 생성할 때만 쓴다
LOG=$VAULT/Logs/$TODAY.md       # sd만 쓴다. 노트에 ![[Logs/날짜]]로 임베드
BREAK_MIN=10                        # 블록 종료 후 ⏰를 보여주는 시간
HIDDEN_APPS=(Slack Mail)            # 블록 시작 시 숨김
BLOCKED_APPS=(Discord KakaoTalk)    # 블록 동안 실행 즉시 종료
AGENDA=$STATE_DIR/agenda.tsv        # 캘린더 읽기 앱만 쓴다: 일정 "시작 epoch<TAB>끝 epoch<TAB>제목", 공휴일 "holiday<TAB>날짜<TAB>이름", 종일 일정 "allday<TAB>날짜<TAB>제목"
AGENDA_APP=${SELF:h:h}/agenda/SDAgenda.app
AGENDA_TTL=45                       # 이보다 오래된 agenda.tsv는 다시 읽는다 (초). 키가 1분마다 부르므로 매번 새로 읽힌다
AGENDA_SYNC_WAIT=4                  # sd calendar: 동기화 요청 후 이만큼 기다렸다 읽는다 (초). 동기화는 3초쯤 걸린다
WORK_START=09:00                    # 출근. 퇴근 공백은 다음 근무일(주말·공휴일이 아닌 날) 이 시각에 끝난다
OFF_TITLE=퇴근                      # 근무일마다 캘린더에 이 제목의 일정을 둔다. 시작 시각이 퇴근이다
VACATION_WORD=휴가                  # 제목에 이 글자가 든 종일 일정이 있는 날은 근무일이 아니다
LONG_MIN=180                        # 이 분 이상 비우면 긴 공백 (자리 비움 키 아랫칸)

die() { print -u2 "sd: $*"; exit 1; }

# 백그라운드(_guard) 알림. ~/.focus/notify에 쓰면 Hammerspoon이 읽어서 띄우고 지운다.
# 포그라운드 명령은 결과를 stdout에 찍고, 부른 쪽(Hammerspoon)이 알림으로 띄운다.
notify() {  # notify <메시지>
  if pgrep -xq Hammerspoon; then
    print -r -- "$1" > $STATE_DIR/notify.tmp && mv $STATE_DIR/notify.tmp $STATE_DIR/notify
  else
    osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "sd"' -e 'end run' "$1"
  fi
}

# 방해금지 on/off. macOS에 CLI가 없어 단축어 "SD Focus On"/"SD Focus Off"(집중 모드 설정 1개)를 부른다.
# 실패해도 블록은 진행하고, 이유를 stdout으로 알린다.
focus() {  # focus On|Off
  shortcuts run "SD Focus $1" >/dev/null 2>&1 || print "⚠️ 방해금지 $1 실패: 단축어 'SD Focus $1'을 확인하세요"
}

ensure_note() {
  [[ -f $NOTE ]] && return
  [[ -f $VAULT/Templates/Daily.md ]] || die "템플릿 없음: $VAULT/Templates/Daily.md"
  mkdir -p $VAULT/Daily
  local title=$(LC_ALL=C date '+%Y-%m-%d %a')
  sed -e "s/{{date:YYYY-MM-DD ddd}}/$title/" -e "s/{{date:YYYY-MM-DD}}/$TODAY/g" \
    $VAULT/Templates/Daily.md > $NOTE
}

open_note() {
  open "obsidian://open?vault=$VAULT_NAME&file=Daily%2F$TODAY"
}

append_log() {
  ensure_note
  mkdir -p $VAULT/Logs
  print -r -- "$1" >> $LOG
}

# 완료 조건 기본값: 오늘 마지막 interrupt의 '다음:', 없으면 미완료 MIT 첫 leaf 항목.
default_task() {
  local next=$(sed -n 's/^- [0-9:]* interrupt — 다음: //p' $LOG 2>/dev/null | tail -1)
  if [[ -n $next ]]; then print -r -- $next; return; fi
  local first=$(mit_open | head -1)
  split_target "$first"
  print -r -- "$TEXT"
}

# MIT의 leaf 항목(하위 항목이 없는 항목)만 "완료(1|0)<TAB>줄 끝 [N] 그대로" 한 줄씩. 들여쓰기는 탭 = 4칸.
# "- [x] "는 완료, "- [ ] "와 체크박스 없는 "- "는 미완료. 체크박스는 떼고 내보낸다.
# 예: "- [ ] 레포 파악" 아래 "\t- [ ] 문제 확인"이 있으면 "문제 확인"만 나온다.
mit_items() {
  awk '/^## /{ in_mit = ($0 == "## MIT"); next }
       in_mit && /^[ \t]*- / {
         ind = $0; sub(/- .*/, "", ind); gsub(/\t/, "    ", ind)
         t = $0; sub(/^[ \t]*- /, "", t); sub(/[ \t]+$/, "", t)
         d = (t ~ /^\[[xX]\]/); sub(/^\[[ xX]\] */, "", t)
         n++; depth[n] = length(ind); text[n] = t; checked[n] = d
       }
       END { for (i = 1; i <= n; i++)
               if (text[i] != "" && (i == n || depth[i + 1] <= depth[i])) print checked[i] "\t" text[i] }' $NOTE 2>/dev/null || true
}

mit_open() {  # 미완료 MIT leaf 항목만, 완료 표시 없이
  mit_items | awk -F'\t' '$1 == 0 { print $2 }'
}

# MIT 줄 끝 목표를 떼어 TEXT와 TARGET(분, 없으면 빈 값)에 넣는다.
# [150m]은 150분, 예전 표기 [N]은 N × 50분.
split_target() {  # split_target <MIT 줄>
  TEXT=${1:-} TARGET=
  [[ $TEXT =~ ' *\[([0-9]+)(m?)\] *$' ]] || return 0
  TEXT=${TEXT[1,MBEGIN-1]}
  [[ -n $match[2] ]] && TARGET=$match[1] || TARGET=$(( match[1] * 50 ))
}

# 완료한 블록의 분. end deep = 50, end deep25 = 25 (deepN = N분).
# 작업별: "분<TAB>작업". start 다음에 오는 end만 그 작업의 완료다. shutdown으로 끊긴 블록은 세지 않는다.
task_minutes() {
  awk '/^- [0-9:]* start deep[0-9]* — / { cur = $0; sub(/^- [0-9:]* start deep[0-9]* — /, "", cur); next }
       /^- [0-9:]* end deep[0-9]*$/ {
         m = $0; sub(/.*end deep/, "", m); if (m == "") m = 50
         if (cur != "") h[cur] += m; cur = ""; next }
       /^- [0-9:]* shutdown$/ { cur = "" }
       END { for (t in h) print h[t] "\t" t }' $LOG 2>/dev/null || true
}

# Deep 선택창 후보: 미완료 MIT leaf 항목만. 기본값(default_task)이 MIT leaf면 맨 위로 올린다.
# 새로 입력한 작업은 노트에 쓰지 않는다. start 줄로 로그에만 남고, 후보에는 나오지 않는다.
cmd_tasks() {
  local -A minutes target
  local -a seen
  local h t line
  while IFS=$'\t' read -r h t; do [[ -n $t ]] && minutes[$t]=$h; done < <(task_minutes)
  emit() {  # emit <작업>
    [[ -n ${1// } ]] && (( ! ${seen[(Ie)$1]} )) || return 0
    seen+=$1
    print -r -- "$1"$'\t'"완료 ${minutes[$1]:-0}${target[$1]:+/${target[$1]}}m"
  }
  local -a mits=()
  for line in "${(@f)$(mit_open)}"; do
    split_target "$line"
    t=$TEXT; [[ -n $TARGET ]] && target[$t]=$TARGET
    mits+=$t
  done
  t=$(default_task)
  (( ${mits[(Ie)$t]} )) && emit "$t"
  for t in $mits; do emit "$t"; done
}

ask_task() {  # ask_task <분>  (터미널에서 인자 없이 부를 때. Hammerspoon은 선택창을 쓴다)
  osascript -e 'on run argv' \
    -e 'activate' \
    -e 'text returned of (display dialog "이 블록이 끝나면 무엇이 되어 있나?" default answer (item 1 of argv) with title (item 2 of argv))' \
    -e 'end run' "$(default_task)" "Deep $1" 2>/dev/null || die "블록 취소됨"
}

json_str() { local s=${1//\\/\\\\}; print -rn -- "\"${s//\"/\\\"}\""; }

write_state() {  # write_state off | day | deep <task> <started> <ends>
  mkdir -p $STATE_DIR
  if [[ $1 == off ]]; then
    print '{"mode": "off"}' > $STATE
  elif [[ $1 == day ]]; then
    print "{\"mode\": \"day\", \"date\": \"$TODAY\"}" > $STATE
  else
    print -r -- "{\"mode\": \"$1\", \"task\": $(json_str $2), \"started\": \"$3\", \"ends\": \"$4\"}" > $STATE
  fi
}

quit_app() { osascript -e "quit app \"$1\"" }
# 종료 요청만 보내고 기다리지 않는다. 확인창이 떠도 단축어의 다음 단계가 막히지 않게.
quit_app_async() { quit_app $1 >/dev/null 2>&1 &! }

clear_distractions() {
  local app
  for app in $HIDDEN_APPS; do
    pgrep -xq $app && osascript -e "tell application \"System Events\" to set visible of process \"$app\" to false"
  done
  for app in $BLOCKED_APPS; do
    pgrep -xq $app && quit_app_async $app
  done
  return 0
}

cmd_start_day() {
  ensure_note
  mkdir -p $VAULT/Logs && touch $LOG   # 노트의 로그 링크가 처음부터 열리도록
  write_state day
  cmd_calendar
  open "https://tasks.google.com"
  open_note
  print "데일리 노트·Calendar·Tasks를 열었습니다. MIT 1개를 적으세요"
}

cmd_deep() {  # cmd_deep <분> [완료 조건]
  local minutes=$1 task=${2:-}
  local kind=deep; (( minutes == 50 )) || kind=deep$minutes   # 로그 이름: deep(50분), deep25
  [[ -n $task ]] || task=$(ask_task $minutes)
  task=${task//$'\n'/ }
  [[ -n ${task// } ]] || die "완료 조건이 비어 있어 블록을 시작하지 않음"

  local started=$(date +%FT%T) ends=$(date -v+${minutes}M +%FT%T)
  focus On
  append_log "- $(date +%H:%M) start $kind — $task"
  write_state deep $task $started $ends
  clear_distractions
  nohup $SELF _guard $(date -v+${minutes}M +%s) $started $kind >/dev/null 2>&1 &!
  local until=$(date -v+${minutes}M +%H:%M)
  print -r -- "Deep $minutes 시작 ~$until — $task"
}

block_active() { grep -qF "\"started\": \"$1\"" $STATE 2>/dev/null }

# 블록 동안 5초마다 BLOCKED_APPS를 종료하고 이탈로 기록한다.
# 블록이 바뀌거나(started 불일치) 해제되면 조용히 끝난다.
cmd__guard() {
  local ends=$1 started=$2 kind=${3:-deep} app
  while (( $(date +%s) < ends )); do
    sleep 5
    block_active $started || return 0
    for app in $BLOCKED_APPS; do
      pgrep -xq $app || continue
      quit_app $app
      append_log "- $(date +%H:%M) distraction $app (closed)"
      notify "딥 블록 중: $app 종료함 (~$(date -r $ends +%H:%M))"
    done
  done
  block_active $started || return 0
  focus Off
  append_log "- $(date +%H:%M) end $kind"
  notify "블록 종료 — 집중도 1~5를 기록하고 화면 밖에서 쉬세요"
}

field() { sed -n "s/.*\"$1\": \"\([^\"]*\)\".*/\1/p" $STATE 2>/dev/null }

# MIT 진행: "📌 완료/전체 · 다음 미완료 MIT". MIT leaf 항목 중 체크한 수 / 전체 수.
status_day() {
  local -a all=(${(f)"$(mit_items)"}) open=(${(f)"$(mit_open)"})
  split_target "${open[1]:-}"
  if (( ! ${#all} )); then TEXT="MIT를 적으세요"
  elif (( ! ${#open} )); then TEXT="MIT 완료"
  fi
  print -r -- "📌 $(( ${#all} - ${#open} ))/${#all} · $TEXT"
}

# 출력 없음 = 표시 없음 (Shutdown 후, 다른 날짜의 상태)
cmd_status() {
  case $(field mode) in
    day)
      [[ $(field date) == $TODAY ]] && status_day ;;
    deep)
      local started=$(field started) ends=$(field ends)
      [[ ${started[1,10]} == $TODAY ]] || return 0
      local left=$(( ($(date -j -f %FT%T $ends +%s) - $(date +%s) + 59) / 60 ))
      if (( left > 0 )); then
        print -r -- "🎯 ${left}m · $(field task)"
      elif (( left > -BREAK_MIN )); then
        print "⏰ 블록 종료 · 집중도를 기록하고 쉬세요"
      else
        status_day
      fi ;;
  esac
  return 0
}

# 블록 중이 아니면 출력 없음. 블록 중인지는 status(🎯)와 같은 기준(끝나는 시각이 아직 안 지남)이다.
cmd_timer() {
  [[ $(field mode) == deep ]] || return 0
  local started=$(date -j -f %FT%T $(field started) +%s) ends=$(date -j -f %FT%T $(field ends) +%s)
  (( ends > $(date +%s) )) && print "$ends $(( ends - started ))"
  return 0
}

# 캘린더 읽기 앱 실행. 이미 떠 있으면(권한 창 대기, 동기화 대기) 다시 띄우지 않는다: open이 응답을 기다리며 멈춘다.
run_agenda_app() {  # run_agenda_app [기다릴 초]
  [[ -x $AGENDA_APP/Contents/MacOS/sd-agenda ]] || return 1
  pgrep -qf "^$AGENDA_APP/Contents/MacOS/sd-agenda " || open -g $AGENDA_APP --args $AGENDA "$@"
}

# 기다리지 않는다. 읽기 앱이 동기화를 요청하고 AGENDA_SYNC_WAIT초 뒤 agenda.tsv를 쓰면, ~/.focus를 감시하는 쪽이 다시 그린다.
cmd_calendar() {
  open "https://calendar.google.com/calendar/r/day"
  run_agenda_app $AGENDA_SYNC_WAIT || true
}

# 자리 비움 (adr/009). 캘린더 일정(식사 포함)과 퇴근 중 지금 이후의 공백을 모아, 이어지거나 겹치는 것은 하나로 합친다(이름은 가장 긴 것).
# 가까운 공백과 다음 긴 공백(LONG_MIN 이상)을 한 줄로 낸다. 같은 공백이면 하나만. 판단은 여기서 하고 표시하는 쪽은 모양만 정한다.
#   ⚪ 주간 싱크 · 42m ↦30m | 퇴근 · 3h20m ↦14h   남은 시간 ↦ 비우는 길이
#   🟠 퇴근 · 40m ↦2d                            가까운 공백이 곧 긴 공백 (금요일, 연휴 전날은 ↦ 길이가 일 단위)
#   ⚪ 점심 · 지금 ↦25m | 퇴근 · 5h ↦14h          진행 중이면 남은 길이
#   ! 문구                                       읽지 못함
# 색: 오래 비울수록 일찍 알린다(away_lead). 🟠 준비 시작, 🔴 지금 넘기기, ⚪ 그 전. 두 공백 중 급한 쪽을 따른다.
cmd_agenda() {
  local now=$(date +%s) mtime
  mtime=$(stat -f %m $AGENDA 2>/dev/null) || mtime=0
  if (( now - mtime >= AGENDA_TTL )); then
    mkdir -p $STATE_DIR
    run_agenda_app || { print "! 읽기 앱 없음"; return 0 }
    # 보통 1초 안에 끝난다. 권한 창이 떠 있으면 기다리지 않고 예전 내용을 쓴다
    repeat 20; do
      sleep 0.1
      mtime=$(stat -f %m $AGENDA 2>/dev/null) || mtime=0
      (( mtime >= now )) && break
    done
  fi
  [[ -f $AGENDA ]] || { print "! 캘린더 읽는 중"; return 0 }

  local -a away holidays  # away: "시작 epoch<TAB>끝 epoch<TAB>이름"
  local a b c
  while IFS=$'\t' read -r a b c; do
    [[ $a == '!'* ]] && { print -r -- "$a"; return 0 }
    if [[ $a == holiday || ( $a == allday && $c == *$VACATION_WORD* ) ]]; then
      holidays+=($b)
    elif [[ $a == <-> && $b == <-> ]]; then
      away+=("$a"$'\t'"$b"$'\t'"${${c//|/¦}//·/•}")  # 출력의 구분자(|, ·)와 섞이지 않게
    fi
  done < $AGENDA

  # 퇴근 일정은 시작 시각만 쓴다. 공백은 그때부터 다음 근무일 출근까지라 일정 자체는 뺀다
  local today=$(date +%F) off= next tab=$'\t'
  local i=${away[(I)*${tab}$OFF_TITLE]}
  if (( i )); then
    off=${away[i]%%$'\t'*}
    away[i]=()
  fi
  if is_workday $today; then
    [[ -n $off ]] || { print "! 오늘 $OFF_TITLE 일정 없음"; return 0 }
    (( now < $(epoch_at $today $WORK_START) )) && away+=("$now"$'\t'"$(epoch_at $today $WORK_START)"$'\t'$OFF_TITLE)
  else
    off=$now
  fi
  for i in {1..15}; do
    next=$(date -v+${i}d +%F)
    is_workday $next && break
  done
  away+=("$off"$'\t'"$(epoch_at $next $WORK_START)"$'\t'$OFF_TITLE)

  local -a merged
  local line s e n ms me mn
  for line in ${(f)"$(print -rl -- $away | sort -n)"}; do
    IFS=$'\t' read -r s e n <<< $line
    (( e > now )) || continue
    if (( $#merged )) && (( s <= me )); then
      (( e - s > me - ms )) && mn=$n
      (( e > me )) && me=$e
      merged[-1]="$ms"$'\t'"$me"$'\t'"$mn"
    else
      ms=$s me=$e mn=$n
      merged+=("$ms"$'\t'"$me"$'\t'"$mn")
    fi
  done

  local near=$merged[1] long=$merged[1]
  for line in $merged; do
    IFS=$'\t' read -r s e n <<< $line
    if (( s > now && e - s >= LONG_MIN * 60 )); then long=$line; break; fi
  done

  local level=⚪ prep go out=()
  for line in $near $long; do
    IFS=$'\t' read -r s e n <<< $line
    if (( s > now )); then
      read -r prep go <<< $(away_lead $(( e - s )))
      if (( s - now <= go * 60 )); then level=🔴
      elif (( s - now <= prep * 60 )) && [[ $level == ⚪ ]]; then level=🟠
      fi
      out+=("$n · $(dur $(( s - now ))) ↦$(dur $(( e - s )))")
    else
      out+=("$n · 지금 ↦$(dur $(( e - now )))")
    fi
    [[ $near == $long ]] && break
  done
  print -r -- "$level ${(j: | :)out}"
}

# 근무일: 주말도, 공휴일·휴가(cmd_agenda가 모은 holidays)도 아닌 날
is_workday() {  # is_workday YYYY-MM-DD
  (( $(date -j -f %F $1 +%u) < 6 )) && (( ! ${holidays[(Ie)$1]} ))
}

epoch_at() {  # epoch_at YYYY-MM-DD HH:MM
  date -j -f '%F %H:%M:%S' "$1 $2:00" +%s
}

# 공백 길이(초) → "준비 시작 분 넘기기 분". 오래 비울수록 깊이 고민하도록 일찍 알린다
away_lead() {
  if (( $1 >= 2 * 86400 )); then print "180 30"
  elif (( $1 >= LONG_MIN * 60 )); then print "90 20"
  else print "30 10"
  fi
}

dur() {  # dur <초> → 42m, 1h, 3h20m, 2d (하루 이상은 일 단위로 내림)
  local m=$(( ($1 + 59) / 60 ))
  if (( m < 60 )); then print ${m}m
  elif (( m >= 1440 )); then print $(( m / 1440 ))d
  elif (( m % 60 )); then print $(( m / 60 ))h$(( m % 60 ))m
  else print $(( m / 60 ))h
  fi
}

cmd_shutdown() {
  write_state off
  focus Off
  append_log "- $(date +%H:%M) shutdown"
  open_note
  print "Shutdown 완료 — 회고와 내일 첫 작업을 적으세요"
}

case ${1:-} in
  start-day) cmd_start_day ;;
  deep)      shift; cmd_deep 50 "${1:-}" ;;
  deep25)    shift; cmd_deep 25 "${1:-}" ;;
  shutdown)  cmd_shutdown ;;
  status)    if [[ ${2:-} == --short ]]; then cmd_status | sed 's/ · .*//'; else cmd_status; fi ;;
  timer)     cmd_timer ;;
  tasks)     cmd_tasks ;;
  agenda)    cmd_agenda ;;
  calendar)  cmd_calendar ;;
  _guard)    shift; cmd__guard "$@" ;;
  *)         die "사용법: sd start-day | deep [완료 조건] | deep25 [완료 조건] | shutdown | status [--short] | timer | tasks | agenda | calendar" ;;
esac
