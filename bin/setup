#!/bin/zsh
# 이 Mac에 sd 시스템을 설치한다. 여러 번 실행해도 안전하다(기존 파일은 덮어쓰지 않음).
#   bin/setup            볼트·상태 폴더·Hammerspoon 설정 후, 남은 수동 단계 출력
# Hammerspoon 설치(brew)와 단축어 생성은 하지 않는다. 필요한 것만 알려준다.
set -euo pipefail

REPO=${0:A:h:h}
VAULT=${SD_VAULT:-$HOME/workspace/personal/record-vault}

[[ $(uname) == Darwin ]] || { print -u2 "setup: macOS 전용"; exit 1; }

chmod +x $REPO/bin/sd

# 기록 볼트: 없는 파일만 복사
mkdir -p $VAULT/{Daily,Weekly,Logs}
rsync -a --ignore-existing $REPO/vault-template/ $VAULT/
print "✓ 기록 볼트: $VAULT"

mkdir -p $HOME/.focus
[[ -f $HOME/.focus/state.json ]] || print '{"mode": "off"}' > $HOME/.focus/state.json
print "✓ 상태 파일: ~/.focus/state.json"

INIT=$HOME/.hammerspoon/init.lua
if [[ -d /Applications/Hammerspoon.app ]]; then
  mkdir -p $INIT:h
  [[ -f $INIT ]] && sed -i '' '/hammerspoon\/sd_hud\.lua/d' $INIT:A   # ADR-004 이전 설정 제거 (:A는 init.lua가 심볼릭 링크일 때)
  grep -qF hammerspoon/sd.lua $INIT 2>/dev/null ||
    print -r -- "dofile(\"$REPO/hammerspoon/sd.lua\").start(\"$REPO\")" >> $INIT
  print "✓ Hammerspoon: $INIT (실행 중이면 Hammerspoon 콘솔에서 hs.reload())"
else
  print "✗ Hammerspoon 없음: brew install --cask hammerspoon 후 bin/setup 재실행"
fi
# 캘린더 읽기 앱(adr/006): 소스가 바뀌었을 때만 빌드한다(다시 빌드하면 캘린더 권한을 다시 물을 수 있다)
AGENDA_APP=$REPO/agenda/SDAgenda.app
AGENDA_BIN=$AGENDA_APP/Contents/MacOS/sd-agenda
if [[ $AGENDA_BIN -nt $REPO/agenda/main.swift ]]; then
  print "✓ 캘린더 읽기 앱"
elif xcrun -f swiftc >/dev/null 2>&1; then
  mkdir -p $AGENDA_BIN:h
  if xcrun swiftc -O $REPO/agenda/main.swift -o $AGENDA_BIN 2>/dev/null && codesign -s - --force $AGENDA_APP 2>/dev/null; then
    print "✓ 캘린더 읽기 앱 (시스템 설정 → 인터넷 계정에 Google 계정·캘린더를 켠 뒤 bin/sd agenda로 권한 허용)"
  else
    print "✗ 캘린더 읽기 앱 빌드 실패: xcrun swiftc -O $REPO/agenda/main.swift -o $AGENDA_BIN"
  fi
else
  print "- 캘린더 읽기 앱 건너뜀 (Xcode 명령줄 도구 없음: xcode-select --install)"
fi

# Stream Deck 표시 플러그인(adr/005): 빌드 후 Stream Deck 앱 플러그인 폴더에 링크
PLUGIN=$REPO/streamdeck-plugin
if [[ -d "/Applications/Elgato Stream Deck.app" ]] && command -v npm >/dev/null; then
  if (cd $PLUGIN && npm ci --silent && npm run -s build >/dev/null 2>&1 && npx streamdeck link com.rroundtable.sd.sdPlugin >/dev/null 2>&1); then
    print "✓ Stream Deck 플러그인 (처음이면 Stream Deck 앱 재시작 후 '남은 시간'·'캘린더' 액션을 키에 놓는다)"
  else
    print "✗ Stream Deck 플러그인 빌드 실패: cd $PLUGIN && npm ci && npm run build"
  fi
else
  print "- Stream Deck 플러그인 건너뜀 (Elgato Stream Deck 앱 또는 npm 없음)"
fi

[[ $VAULT == $HOME/workspace/personal/record-vault ]] ||
  print "! 볼트가 기본 경로가 아님: Hammerspoon이 부르는 sd에는 SD_VAULT가 전달되지 않는다. bin/sd의 VAULT 기본값을 바꾼다."

missing=()
for name in "SD Focus On" "SD Focus Off"; do
  shortcuts list | grep -qxF $name || missing+=$name
done
if (( ${#missing} )); then
  print "✗ 단축어 없음: ${(j:, :)missing} — $REPO/docs/reference/setup.md 3장"
else
  print "✓ 단축어 SD Focus On/Off"
fi
old=$(shortcuts list | grep -xE "SD (Start Day|Deep 50|Shutdown|Notify)" || true)
[[ -z $old ]] || print "! 예전 단축어가 남아 있음(⌃⌥ 키 충돌): ${(j:, :)${(f)old}} — 단축어 앱에서 삭제"
